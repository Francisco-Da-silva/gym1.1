<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="gym1._1.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Gym Manager</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons (para iconitos del menú) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <style>
        body {
            background-color: #0f172a; /* azul oscuro nocturno */
        }

        .layout-root {
            min-height: 100vh;
        }

        /* SIDEBAR GYM */
        .sidebar-gym {
            width: 250px;
            background: radial-gradient(circle at top left, #22c55e 0, #0f172a 40%, #020617 100%);
            color: #e5e7eb;
            box-shadow: 4px 0 15px rgba(0, 0, 0, 0.4);
        }

        .sidebar-gym .brand {
            display: flex;
            align-items: center;
            gap: .6rem;
            margin-bottom: 1.5rem;
        }

        .sidebar-gym .brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 999px;
            background: rgba(15, 23, 42, 0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            color: #22c55e;
        }

        .sidebar-gym .brand-text {
            font-size: 1.15rem;
            font-weight: 600;
            letter-spacing: .03em;
        }

        .sidebar-gym .nav-link {
            color: #e5e7eb;
            border-radius: .5rem;
            padding: .55rem .75rem;
            font-size: .95rem;
            display: flex;
            align-items: center;
            gap: .55rem;
            transition: all .15s ease-in-out;
        }

        .sidebar-gym .nav-link i {
            font-size: 1.1rem;
        }

        .sidebar-gym .nav-link:hover {
            background-color: rgba(15, 23, 42, 0.85);
            color: #22c55e;
            transform: translateX(2px);
        }

        .sidebar-gym .nav-link.active {
            background: linear-gradient(90deg, #22c55e, #16a34a);
            color: #020617;
            font-weight: 600;
        }

        .sidebar-footer {
            font-size: .75rem;
            color: #9ca3af;
        }

        /* CONTENIDO PRINCIPAL */
        .main-area {
            background: radial-gradient(circle at top right, #1f2937 0, #020617 55%);
            color: #e5e7eb;
        }

        .main-header {
            border-bottom: 1px solid rgba(148, 163, 184, 0.35);
        }

        .main-card {
            background-color: #020617;
            border-radius: 1rem;
            box-shadow: 0 18px 35px rgba(0, 0, 0, 0.45);
        }

        .main-card h3,
        .main-card h2 {
            color: #22c55e;
        }

        /* Para que tus GridView bootstrap se vean bien sobre fondo oscuro */
        .table {
            background-color: #020617;
            color: #e5e7eb;
        }

        .table thead {
            background-color: #111827;
        }

        .table tbody tr:hover {
            background-color: #0b1120;
        }

        .btn-success {
            background: linear-gradient(90deg, #22c55e, #16a34a);
            border: none;
        }

        .btn-danger {
            background: linear-gradient(90deg, #ef4444, #b91c1c);
            border: none;
        }
    </style>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server" />

        <div class="d-flex layout-root">

            <!-- SIDEBAR LATERAL GYM -->
            <aside class="sidebar-gym d-flex flex-column p-3">
                <div class="brand mb-3">
                    <div class="brand-icon">
                        <i class="bi bi-barbell"></i>
                    </div>
                    <div class="brand-text">
                        Gym Manager
                    </div>
                </div>

                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item mb-1">
                        <a class="nav-link text-white" runat="server" href="~/">
                            <i class="bi bi-house-door"></i>
                            Inicio
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a class="nav-link text-white" runat="server" href="~/Pagos">
                            <i class="bi bi-info-circle"></i>
                            Pagos
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a class="nav-link text-white" runat="server" href="~/Clientes">
                            <i class="bi bi-people"></i>
                            Listado de clientes
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a class="nav-link text-white" runat="server" href="~/Registro">
                            <i class="bi bi-person-plus"></i>
                            -Registrar clientes
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a class="nav-link text-white " runat="server" href="~/Deudores">
                            Deudores</a>

                    </li>

                     <li class="nav-item mb-1">
                         <a class="nav-link text-white " runat="server" href="~/CrearAdministrador">
                             Crear administrador</a>

                     </li>


                    <asp:LinkButton
    ID="btnCerrarSesion"
    runat="server"
    CssClass="nav-link"
    CausesValidation="false"
    OnClick="btnCerrarSesion_Click">

    <i class="bi bi-box-arrow-right"></i>
    Cerrar sesión

</asp:LinkButton>

                </ul>

                <div class="mt-auto sidebar-footer">
                    &copy; <%: DateTime.Now.Year %> - Gym Manager
                    <br />
                    <span class="text-success">#NoPainNoGain</span>
                </div>
            </aside>

            <!-- CONTENIDO PRINCIPAL -->
            <main class="flex-grow-1 main-area d-flex flex-column">
                <!-- Cabecera de cada página -->
                <header class="main-header">
                    <div class="container py-3">
                        <h1 class="h4 mb-0"><%: Page.Title %></h1>
                    </div>
                </header>

                <!-- Zona de contenido -->
                <div class="container py-4 flex-grow-1">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>
            </main>
        </div>
    </form>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
