<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="gym1._1.SiteMaster" %>
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> - Gym Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" runat="server" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" runat="server" />
</head>
<body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <form runat="server">
        <asp:ScriptManager runat="server" />
        <div class="layout-root">
            <aside id="gym-sidebar" class="sidebar-gym" aria-label="Menú principal">
                <button id="menu-close" class="icon-button sidebar-close" type="button" aria-label="Cerrar menú"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                <a class="brand" href="<%= ResolveUrl("~/Default.aspx") %>" aria-label="Gym Manager, inicio">
                    <i class="bi bi-grid-1x2 brand-icon" aria-hidden="true"></i><span class="sidebar-label">Gym Manager</span>
                </a>
                <div class="sidebar-caption">Gestión</div>
                <nav aria-label="Secciones"><ul class="nav flex-column">
<li class="nav-item"><a id="navInicio" runat="server" href="~/Default.aspx" class="nav-link" aria-label="Inicio" title="Inicio"><i class="bi bi-house-door" aria-hidden="true"></i><span class="sidebar-label">Inicio</span></a></li>
<asp:PlaceHolder ID="menuGimnasio" runat="server" Visible="false">
<li class="nav-item"><a id="navPagos" runat="server" href="~/Pagos.aspx" class="nav-link" aria-label="Pagos" title="Pagos"><i class="bi bi-cash-coin" aria-hidden="true"></i><span class="sidebar-label">Pagos</span></a></li>
<li class="nav-item"><a id="navClientes" runat="server" href="~/Clientes.aspx" class="nav-link" aria-label="Listado de clientes" title="Listado de clientes"><i class="bi bi-people" aria-hidden="true"></i><span class="sidebar-label">Listado de clientes</span></a></li>
<li class="nav-item"><a id="navRegistro" runat="server" href="~/Registro.aspx" class="nav-link" aria-label="Registrar clientes" title="Registrar clientes"><i class="bi bi-person-plus" aria-hidden="true"></i><span class="sidebar-label">Registrar clientes</span></a></li>
<li class="nav-item"><a id="navDeudores" runat="server" href="~/Deudores.aspx" class="nav-link" aria-label="Deudores" title="Deudores"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span class="sidebar-label">Deudores</span></a></li>
</asp:PlaceHolder>
<asp:PlaceHolder ID="pnlSuperAdministrador" runat="server" Visible="false">
<li class="sidebar-caption">Plataforma</li>
<li class="nav-item"><a id="navGimnasios" runat="server" href="~/AdministrarGimnasios.aspx" class="nav-link" aria-label="Administrar gimnasios" title="Administrar gimnasios"><i class="bi bi-buildings" aria-hidden="true"></i><span class="sidebar-label">Administrar gimnasios</span></a></li>
<li class="nav-item"><a id="navCrearGimnasio" runat="server" href="~/CrearAdministrador.aspx" class="nav-link" aria-label="Registrar gimnasio" title="Registrar gimnasio"><i class="bi bi-building-add" aria-hidden="true"></i><span class="sidebar-label">Registrar gimnasio</span></a></li>
</asp:PlaceHolder>
                </ul></nav>
                <div class="sidebar-account">
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Default.aspx#mi-cuenta" aria-label="Mi cuenta" title="Mi cuenta"><i class="bi bi-person-circle" aria-hidden="true"></i><span class="sidebar-label">Mi cuenta</span></a></li>
                        <li class="nav-item"><asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="nav-link" CausesValidation="false" OnClick="btnCerrarSesion_Click" aria-label="Cerrar sesión" title="Cerrar sesión"><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span class="sidebar-label">Cerrar sesión</span></asp:LinkButton></li>
                    </ul>
                    <div class="sidebar-footer">&copy; <%: DateTime.Now.Year %> Gym Manager</div>
                </div>
            </aside>
            <button id="menu-backdrop" type="button" class="sidebar-backdrop" aria-label="Cerrar menú" tabindex="-1" hidden></button>
            <div class="main-area">
                <header class="main-header">
                    <div class="header-leading">
                        <button id="menu-toggle" type="button" class="icon-button" aria-controls="gym-sidebar" aria-expanded="true" aria-label="Contraer menú" hidden><i class="bi bi-list" aria-hidden="true"></i></button>
                        <div><div class="header-context"><%: NombreContexto %></div><h1><%: Page.Title %></h1></div>
                    </div>
                    <div class="header-account"><strong><%: Convert.ToString(Session["NombreUsuario"]) %></strong><span><%: TipoCuenta %></span></div>
                </header>
                <main id="main-content" class="page-content" tabindex="-1"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
            </div>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%= ResolveUrl("~/Scripts/gym-shell.js") %>" defer></script>
</body>
</html>
